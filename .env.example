# CDM — copy to .env and fill in. .env is gitignored (SEC4).
# Every value marked :? in compose.yaml is required; the stack refuses to
# start without it rather than falling back to a default secret.

# ── Tailscale ───────────────────────────────────────────────────────────
# Your tailnet name, without the .ts.net suffix.
# Find it at: https://login.tailscale.com/admin/dns  (e.g. "tail1a2b3c")
TS_TAILNET=

# One auth key for the ingress sidecar. Generate at:
#   https://login.tailscale.com/admin/settings/keys
# Recommended: Reusable OFF, Ephemeral OFF, Tags: tag:cdm
# Ephemeral must be OFF, or the node disappears on restart and the
# certificate with it.
TS_AUTHKEY=

# ── Databases ───────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
POSTGRES_APP_PASSWORD=
POSTGRES_AUTH_PASSWORD=

# ── Keycloak bootstrap admin ────────────────────────────────────────────
# Used only to create the first admin account on first start. Change the
# password in the Keycloak UI afterwards and these become inert.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=

# ── Forward-auth gateway (oauth2-proxy) ──────────────────────
# Only used by FUTURE services that cannot speak OIDC themselves. CDM's own
# web and api authenticate directly against Keycloak and ignore this.
#
# Create a confidential client `cdm-forward-auth` in the Keycloak realm, with
# valid redirect URI  https://<host>.ts.net/oauth2/callback  and paste its
# secret here.
OAUTH2_PROXY_CLIENT_SECRET=

# Must be exactly 16, 24 or 32 bytes. Generate with:
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
